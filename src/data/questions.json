        { "id": "world-pvp", "label": { "newcomer": "Fighting other players out in the world", "veteran": "World PvP" }, "axis": "worldPvp" },
        { "id": "battlegrounds", "label": { "newcomer": "Team PvP battlegrounds", "veteran": "Battlegrounds" }, "axis": "battlegrounds" },
