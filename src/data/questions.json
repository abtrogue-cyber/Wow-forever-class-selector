          "effects": { "axes": { "sustain": { "target": 5, "weight": 2.5 } } } }
      ]
    },
    {
      "id": "bad-pull", "type": "scenario",
      "text": { "newcomer": "A fight goes wrong: three more enemies join in. You'd rather…", "veteran": "Bad pull, two adds. Your out?" },
      "options": [
        { "id": "escape", "label": { "newcomer": "Have an escape button and get out", "veteran": "Blink, Vanish or Feign, then reset" },
          "effects": { "axes": { "survivability": { "target": 4, "weight": 1.2 } }, "tags": { "trickster": 0.5 } } },
        { "id": "outlast", "label": { "newcomer": "Outlast them: take a beating and heal myself", "veteran": "Self-heal and facetank it" },
          "effects": { "axes": { "survivability": { "target": 5, "weight": 1.2 }, "armor": { "target": 4, "weight": 0.3 } } } },
        { "id": "control", "label": { "newcomer": "Lock one down and handle the rest", "veteran": "CC one, kill the rest" },
          "effects": { "axes": { "groupUtility": { "target": 3.5, "weight": 0.6 }, "survivability": { "target": 3.5, "weight": 0.8 } } } },
        { "id": "burn", "label": { "newcomer": "Burn them down before they hurt me", "veteran": "Pop cooldowns and burn" },
          "effects": { "axes": { "burst": { "target": 4, "weight": 0.6 }, "survivability": { "target": 3, "weight": 0.4 } } } },
        { "id": "graveyard", "label": { "newcomer": "Eh, I'll run back from the graveyard", "veteran": "Die, run back, try again" },
          "hardcoreLabel": { "newcomer": "Hope for the best, even with just one life", "veteran": "Send it. One life, no regrets." },
          "effects": {} }
