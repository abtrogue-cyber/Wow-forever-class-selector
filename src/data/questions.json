          "effects": { "axes": { "sustain": { "target": 3.5, "weight": 1 } } } },
        { "id": "annoying", "label": { "newcomer": "Annoying", "veteran": "Annoying" },
          "effects": { "axes": { "sustain": { "target": 4, "weight": 1.8 } } } },
