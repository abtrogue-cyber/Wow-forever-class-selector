    {
      "id": "look", "type": "pickOne",
      "text": { "newcomer": "Which look feels most like you?", "veteran": "Which look feels most like you?" },
      "options": [
        { "id": "noble", "label": { "newcomer": "Noble and shining", "veteran": "Noble" }, "effects": { "aesthetic": { "noble": 3 } } },
        { "id": "rugged", "label": { "newcomer": "Rugged and bearded", "veteran": "Rugged" }, "effects": { "aesthetic": { "rugged": 3 } } },
